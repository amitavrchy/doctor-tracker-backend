# Runtime environment: development, production, or test.
NODE_ENV=development
# HTTP server port.
PORT=5000
# MongoDB connection string; replace with your own.
MONGODB_URI=<your-mongodb-connection-string>
# MongoDB database name.
MONGODB_DB_NAME=doctor-tracker
# Random signing secret of at least 32 characters.
JWT_SECRET=replace-with-at-least-32-random-characters
# Comma-separated allowed browser origins.
CLIENT_URL=http://localhost:3000
# lax, strict, or none; none requires COOKIE_SECURE=true.
COOKIE_SAME_SITE=lax
# Use true for HTTPS.
COOKIE_SECURE=false
# Use true behind a trusted proxy.
TRUST_PROXY=false
# Admin seed email.
ADMIN_EMAIL=admin@example.com
# Admin seed password: at least 12 characters and at most 72 UTF-8 bytes.
ADMIN_PASSWORD=replace-with-a-strong-password
# Admin seed display name.
ADMIN_NAME=Administrator
